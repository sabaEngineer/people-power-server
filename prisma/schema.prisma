generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  avatar    String?
  googleId  String    @unique
  timeZone  String    @default("UTC")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contact[]
  tags      Tag[]
}

model Contact {
  id                String                 @id @default(cuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  birthday          DateTime?              @db.Date
  birthdayReminders BirthdayReminderType[] @default([])
  phone             String?
  socialUrl         String?
  description       String?
  facts             Fact[]
  tags              ContactTag[]
  birthdayReminderLogs BirthdayReminderLog[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([userId])
}

enum FactType {
  PAIN
  GOAL
  LIKE
}

model Fact {
  id              String                 @id @default(cuid())
  contactId       String
  contact         Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type            FactType
  content         String
  reminderDate    DateTime?              @db.Date
  reminderTimings BirthdayReminderType[] @default([])
  reminderLogs    FactReminderLog[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([contactId])
  @@index([reminderDate])
}

model FactReminderLog {
  id     String               @id @default(cuid())
  factId String
  fact   Fact                 @relation(fields: [factId], references: [id], onDelete: Cascade)
  type   BirthdayReminderType
  sentAt DateTime             @default(now())

  @@unique([factId, type])
  @@index([factId])
}

model Tag {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  contacts  ContactTag[]
  createdAt DateTime     @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

enum BirthdayReminderType {
  ON_DAY
  DAY_BEFORE
  ONE_WEEK_BEFORE
  ONE_MONTH_BEFORE
}

model BirthdayReminderLog {
  id        String               @id @default(cuid())
  contactId String
  contact   Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      BirthdayReminderType
  year      Int
  sentAt    DateTime             @default(now())

  @@unique([contactId, type, year])
  @@index([contactId])
}
